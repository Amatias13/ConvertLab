# ─── ConvertLab environment variables ────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and will never be committed.
#
# See README.md → "Feedback System" for setup instructions.

# ─── EmailJS (feedback modal) ─────────────────────────────────────
# Required for the in-app feedback form to send emails.
# Get these from https://www.emailjs.com → your service/template/account.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ─── Pollinations (AI Text Enhancer) ─────────────────────────────
# Optional. Without this the tool works in anonymous/rate-limited mode.
# Set to your Pollinations API key for full access.
VITE_POLLINATIONS_SK=
